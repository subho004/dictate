# Copy this file to .env in the project root and fill in your own keys.
# .env is gitignored — never commit real API keys.

# AssemblyAI — used for real-time speech-to-text streaming.
# Get a key at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Google Gemini — used to transform selected text into spoken commands.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
